+  async listarTiposAlimento(filtro: ListarTiposAlimentoDto) {
+    const where = {
+      ...(filtro.estado ? { activo: filtro.estado === 'ACTIVO' } : {}),
+      ...(filtro.tipo_almacenamiento ? { tipo_almacenamiento: filtro.tipo_almacenamiento } : {}),
+      ...(filtro.q ? { OR: [{ nombre: { contains: filtro.q, mode: 'insensitive' as const } }, { codigo: { contains: filtro.q, mode: 'insensitive' as const } }] } : {}),
+    };
+    const [datos, total] = await this.prisma.$transaction([
+      this.prisma.tipo_alimento.findMany({ where, orderBy: [{ nombre: 'asc' }, { id: 'asc' }], take: filtro.limite, skip: filtro.desplazamiento, select: {
+        id: true, codigo: true, nombre: true, categoria_alimento_id: true, unidad_medida_id: true,
+        requiere_refrigeracion: true, tipo_almacenamiento: true, perecedero: true, vida_util_dias: true, activo: true,
+      } }),
+      this.prisma.tipo_alimento.count({ where }),
+    ]);
+    return { datos, total, limite: filtro.limite, desplazamiento: filtro.desplazamiento };
+  }
