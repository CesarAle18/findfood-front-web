diff --git a/src/modulos/admin/alimentos-admin.spec.ts b/src/modulos/admin/alimentos-admin.spec.ts
new file mode 100644
index 0000000..10cbaa5
--- /dev/null
+++ b/src/modulos/admin/alimentos-admin.spec.ts
@@ -0,0 +1,56 @@
+import 'reflect-metadata';
+import { plainToInstance } from 'class-transformer';
+import { validate } from 'class-validator';
+import { Reflector } from '@nestjs/core';
+import type { ExecutionContext } from '@nestjs/common';
+import { RolesGuard } from '../../comun/auth/roles.guard';
+import type { PrismaService } from '../../comun/prisma/prisma.service';
+import type { TrazabilidadService } from '../../comun/trazabilidad/trazabilidad.service';
+import { AdminController } from './admin.controller';
+import { CatalogosService } from './catalogos.service';
+import { ListarTiposAlimentoDto } from './admin.dto';
+
+function setup() {
+  const rows = [{ id: 1, nombre: 'Mamoncillo', codigo: 'MAMONCILLO', activo: false }];
+  const foods = { findMany: jest.fn().mockResolvedValue(rows), count: jest.fn().mockResolvedValue(1), findUnique: jest.fn().mockResolvedValue(rows[0]), update: jest.fn().mockResolvedValue({ ...rows[0], activo: true }) };
+  const audit = jest.fn().mockResolvedValue(undefined);
+  const prisma = { tipo_alimento: foods, $transaction: (queries: Promise<unknown>[]) => Promise.all(queries), transaccion: (callback: (tx: unknown) => unknown) => callback({ tipo_alimento: foods }) };
+  const service = new CatalogosService(prisma as unknown as PrismaService, { auditar: audit } as unknown as TrazabilidadService);
+  return { service, foods, audit };
+}
+describe('administración de alimentos', () => {
+  it('incluye inactivos en el listado administrativo y pagina en el servidor', async () => {
+    const { service, foods } = setup();
+    const result = await service.listarTiposAlimento(plainToInstance(ListarTiposAlimentoDto, { limite: 10, desplazamiento: 20 }));
+    expect(result.datos[0].activo).toBe(false);
+    expect(foods.findMany).toHaveBeenCalledWith(expect.objectContaining({ where: {}, take: 10, skip: 20, select: expect.objectContaining({ activo: true }) }));
+    expect(result.total).toBe(1);
+  });
+  it('combina búsqueda, estado y régimen antes de paginar', async () => {
+    const { service, foods } = setup();
+    await service.listarTiposAlimento(plainToInstance(ListarTiposAlimentoDto, { q: '  mamon  ', estado: 'INACTIVO', tipo_almacenamiento: 'SECO' }));
+    const query = foods.findMany.mock.calls[0][0];
+    expect(query.where).toEqual({ activo: false, tipo_almacenamiento: 'SECO', OR: [{ nombre: { contains: 'mamon', mode: 'insensitive' } }, { codigo: { contains: 'mamon', mode: 'insensitive' } }] });
+    expect(foods.count).toHaveBeenCalledWith({ where: query.where });
+  });
+  it('reactiva el registro existente y deja auditoría', async () => {
+    const { service, foods, audit } = setup();
+    const result = await service.actualizarTipoAlimento(1, { activo: true }, 'admin');
+    expect(result.id).toBe(1);
+    expect(foods.update).toHaveBeenCalledWith({ where: { id: 1 }, data: { activo: true } });
+    expect(audit).toHaveBeenCalledWith(expect.anything(), expect.objectContaining({ anteriores: expect.objectContaining({ activo: false }), nuevos: { activo: true } }));
+  });
+  it('el catálogo de formularios sigue excluyendo alimentos inactivos', async () => {
+    const { service, foods } = setup();
+    await service.consultar({ incluir: ['tipos_alimento'] });
+    expect(foods.findMany).toHaveBeenCalledWith(expect.objectContaining({ where: { activo: true } }));
+  });
+  it('valida filtros y límites', async () => {
+    expect(await validate(plainToInstance(ListarTiposAlimentoDto, { limite: 20, estado: 'INACTIVO' }))).toHaveLength(0);
+    expect((await validate(plainToInstance(ListarTiposAlimentoDto, { limite: 500, estado: 'OTRO', tipo_almacenamiento: 'OTRO' }))).length).toBeGreaterThan(0);
+  });
+  it.each(['ASESOR_BANCO', 'DONANTE', 'VOLUNTARIO'])('no expone la administración de inactivos al rol %s', (role) => {
+    const context = { getClass: () => AdminController, getHandler: () => () => undefined, switchToHttp: () => ({ getRequest: () => ({ usuario: { roles: [role] } }) }) } as unknown as ExecutionContext;
+    expect(() => new RolesGuard(new Reflector()).canActivate(context)).toThrow();
+  });
+});
