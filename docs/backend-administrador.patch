+import 'reflect-metadata';
+import { of, lastValueFrom } from 'rxjs';
+import { Reflector } from '@nestjs/core';
+import type { ExecutionContext } from '@nestjs/common';
+import { plainToInstance } from 'class-transformer';
+import { validate } from 'class-validator';
+import { RolesGuard } from '../../comun/auth/roles.guard';
+import type { PrismaService } from '../../comun/prisma/prisma.service';
+import { AuditoriaController, ListarAuditoriaDto } from './auditoria.controller';
+import { AuditoriaService, presentarMovimiento } from './auditoria.service';
+import { AuditoriaOperacionInterceptor, datosOperacion } from './auditoria-operacion.interceptor';
+
+function context(role: string, method = 'GET', path = '/v1/admin/auditoria') {
+  return {
+    getClass: () => AuditoriaController,
+    getHandler: () => () => undefined,
+    switchToHttp: () => ({ getRequest: () => ({ usuario: { id: 'actor', roles: [role] }, method, path, params: {}, body: { estado: 'ACEPTADA', password: 'secret', token: 'private', nested: { password: 'hidden' } } }) }),
+  } as unknown as ExecutionContext;
+}
+describe('auditoría global', () => {
+  it.each(['ASESOR_BANCO', 'DONANTE', 'VOLUNTARIO'])('deniega el reporte al rol %s', (role) => {
+    expect(() => new RolesGuard(new Reflector()).canActivate(context(role))).toThrow();
+  });
+  it('permite al administrador consultar movimientos de cualquier rol', () => {
+    expect(new RolesGuard(new Reflector()).canActivate(context('ADMIN'))).toBe(true);
+  });
+  it('valida paginación y fechas', async () => {
+    expect(await validate(plainToInstance(ListarAuditoriaDto, { limite: 100, desplazamiento: 0, desde: '2026-10-30T05:00:00Z' }))).toHaveLength(0);
+    expect((await validate(plainToInstance(ListarAuditoriaDto, { limite: 101, desde: 'invalid' }))).length).toBeGreaterThan(0);
+  });
+  it('describe un movimiento con cantidad, saldo y motivo', () => {
+    const entry = presentarMovimiento({ id: 'inventario:1', fecha: new Date('2026-10-30T10:00:00Z'), actor: 'asesor@example.test', roles: ['ASESOR_BANCO'], modulo: 'movimiento_inventario', accion: 'MERMA', entidad: 'lote', referencia: 'L-001', detalles: { cantidad: '-3', saldo_cantidad: '7', motivo: 'Producto dañado' } });
+    expect(entry.accion).toBe('Registrar merma');
+    expect(entry.descripcion).toContain('L-001');
+    expect(entry.descripcion).toContain('saldo: 7');
+    expect(entry.descripcion).toContain('Producto dañado');
+  });
