@@ -0,0 +1,47 @@
+import { Injectable, Logger, type CallHandler, type ExecutionContext, type NestInterceptor } from '@nestjs/common';
+import { mergeMap, type Observable } from 'rxjs';
+import type { PeticionAutenticada } from '../../comun/auth/decoradores';
+import { PrismaService } from '../../comun/prisma/prisma.service';
+import { Prisma } from '../../generated/prisma/client';
+
+const campos = ['nombre', 'direccion', 'ciudad', 'titulo', 'estado', 'tipo', 'capacidad_kg', 'activo', 'valor', 'tiene_flota_propia', 'cantidad', 'motivo', 'observacion', 'observaciones'];
+export function datosOperacion(body: unknown): Prisma.InputJsonObject {
+  if (!body || typeof body !== 'object' || Array.isArray(body)) return {};
+  return Object.fromEntries(Object.entries(body).filter(([key, value]) => campos.includes(key) && ['string', 'number', 'boolean'].includes(typeof value)));
+}
+
+/** Completa la bitácora de negocio con las solicitudes mutantes de todos los roles. */
+@Injectable()
+export class AuditoriaOperacionInterceptor implements NestInterceptor {
+  private readonly logger = new Logger(AuditoriaOperacionInterceptor.name);
+  constructor(private readonly prisma: PrismaService) {}
+
+  intercept(context: ExecutionContext, next: CallHandler): Observable<unknown> {
+    const request = context.switchToHttp().getRequest<PeticionAutenticada>();
+    const user = request.usuario;
+    if (!user || !['POST', 'PUT', 'PATCH', 'DELETE'].includes(request.method)) return next.handle();
+    const parts = request.path.split('/').filter((part) => part && !/^v\d+$/.test(part));
+    if (['auth', 'notificaciones', 'dispositivos'].some((part) => parts.includes(part))) return next.handle();
+    // Estos servicios ya auditan dentro de su transacción; no duplicar sus entradas.
+    if (parts[0] === 'almacenes' || (parts[0] === 'admin' && ['usuarios', 'verificaciones', 'parametros', 'banco', 'tipos-alimento'].includes(parts[1] ?? ''))) return next.handle();
+    const entity = parts[0] === 'admin' ? parts[1] : parts[0];
+    const operation = parts.at(-1) ?? '';
+    const verbs: Record<string, string> = { aprobar: 'APROBAR', rechazar: 'RECHAZAR', cancelar: 'CANCELAR', iniciar: 'INICIAR', finalizar: 'FINALIZAR', confirmar: 'CONFIRMAR', completar: 'COMPLETAR', llegada: 'REGISTRAR_LLEGADA', atender: 'ATENDER', resolver: 'RESOLVER', suspender: 'SUSPENDER', reactivar: 'REACTIVAR', reasignar: 'REASIGNAR' };
+    const action = verbs[operation] ?? ({ POST: 'CREAR', PUT: 'ACTUALIZAR', PATCH: 'ACTUALIZAR', DELETE: 'ELIMINAR' }[request.method] ?? 'ACTUALIZAR');
+    return next.handle().pipe(mergeMap(async (result: unknown) => {
+      const response = result && typeof result === 'object' ? result as Record<string, unknown> : {};
+      const reference = response.id ?? request.params.id;
+      try {
+        await this.prisma.auditoria.create({ data: {
+          usuario_id: user.id, accion: action, entidad: (entity ?? 'operacion').slice(0, 60),
+          entidad_id: typeof reference === 'string' || typeof reference === 'number' ? String(reference) : null,
+          valores_nuevos: datosOperacion(request.body),
+        } });
+      } catch {
+        // La operación puede haberse confirmado: no devolver un error que invite a duplicarla.
+        this.logger.error(`No se pudo registrar auditoría de ${request.method} ${entity ?? 'operacion'}`);
+      }
+      return result;
+    }));
+  }
+}
