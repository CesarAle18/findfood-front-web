+import { Controller, Get, Query } from '@nestjs/common';
+import { ApiBearerAuth, ApiPropertyOptional, ApiTags } from '@nestjs/swagger';
+import { IsISO8601, IsOptional } from 'class-validator';
+import { Roles } from '../../comun/auth/decoradores';
+import { PaginacionDto } from '../../comun/validacion';
+import { AuditoriaService } from './auditoria.service';
+
+export class ListarAuditoriaDto extends PaginacionDto {
+  @ApiPropertyOptional() @IsOptional() @IsISO8601() desde?: string;
+  /** Límite exclusivo: el cliente envía el inicio del día siguiente. */
+  @ApiPropertyOptional() @IsOptional() @IsISO8601() hasta?: string;
+}
+
+@ApiTags('administración')
+@ApiBearerAuth()
+@Controller('admin/auditoria')
+@Roles('ADMIN')
+export class AuditoriaController {
+  constructor(private readonly auditoria: AuditoriaService) {}
+
+  @Get()
+  listar(@Query() filtro: ListarAuditoriaDto) {
+    return this.auditoria.listar(filtro);
+  }
+}
diff --git a/src/modulos/admin/auditoria.service.ts b/src/modulos/admin/auditoria.service.ts
new file mode 100644
index 0000000..df0f1a5
--- /dev/null
+++ b/src/modulos/admin/auditoria.service.ts
@@ -0,0 +1,100 @@
+import { BadRequestException, Injectable } from '@nestjs/common';
+import { PrismaService } from '../../comun/prisma/prisma.service';
+import { Prisma } from '../../generated/prisma/client';
+import type { ListarAuditoriaDto } from './auditoria.controller';
+
+interface Movimiento {
+  id: string;
+  fecha: Date;
+  actor: string;
+  roles: string[];
+  modulo: string;
+  accion: string;
+  entidad: string;
+  referencia: string | null;
+  detalles: Record<string, string | number | boolean | null>;
+}
+
+const nombres: Record<string, string> = {
+  usuario: 'Usuarios', verificacion_identidad: 'Verificaciones', voluntario: 'Voluntarios',
+  almacen: 'Almacenes', banco_alimentos: 'Banco de alimentos', parametro_sistema: 'Configuración',
+  tipo_alimento: 'Alimentos', DONACION: 'Donaciones', ASIGNACION: 'Asignaciones', RUTA: 'Rutas',
+  PARADA: 'Paradas', INCIDENCIA: 'Incidencias', LOTE: 'Inventario', movimiento_inventario: 'Inventario',
+  usuarios: 'Usuarios', verificaciones: 'Verificaciones', donaciones: 'Donaciones', rutas: 'Rutas', paradas: 'Paradas',
+  recepciones: 'Recepciones', inventario: 'Inventario', alertas: 'Alertas de inventario', incidencias: 'Incidencias',
+  distribuciones: 'Distribuciones', almacenes: 'Almacenes', banco: 'Banco de alimentos', parametros: 'Configuración',
+  me: 'Perfil', evidencias: 'Evidencias', asignaciones: 'Asignaciones',
+};
+const verbos: Record<string, string> = {
+  CREAR: 'Crear', ACTUALIZAR: 'Actualizar', APROBAR: 'Aprobar', RECHAZAR: 'Rechazar',
+  CAMBIAR_ESTADO: 'Cambiar estado', SUSPENDER: 'Suspender', REACTIVAR: 'Reactivar', SOLICITAR: 'Solicitar',
+  ENTRADA: 'Registrar entrada', SALIDA: 'Registrar salida', DEVOLUCION: 'Registrar devolución',
+  AJUSTE: 'Ajustar inventario', MERMA: 'Registrar merma', VENCIMIENTO: 'Registrar vencimiento',
+};
+const legible = (value: string) => value.toLocaleLowerCase('es').replaceAll('_', ' ');
+
+export function presentarMovimiento(row: Movimiento) {
+  const modulo = nombres[row.modulo] ?? legible(row.modulo);
+  const accion = verbos[row.accion] ?? legible(row.accion).replace(/^./, (letter) => letter.toUpperCase());
+  const detalles = Object.fromEntries(Object.entries(row.detalles).filter(([, value]) => value != null).map(([key, value]) => [key, String(value)]));
+  const referencia = row.referencia ? ` (${row.referencia})` : '';
+  let descripcion = `${accion}: ${modulo}${referencia}.`;
+  if (detalles.estado_nuevo) descripcion += ` Estado: ${detalles.estado_anterior ? `${legible(detalles.estado_anterior)} → ` : ''}${legible(detalles.estado_nuevo)}.`;
+  if (detalles.cantidad) descripcion += ` Movimiento: ${detalles.cantidad} unidades; saldo: ${detalles.saldo_cantidad}.`;
+  if (detalles.campos) descripcion += ` Campos modificados: ${detalles.campos}.`;
+  if (detalles.motivo) descripcion += ` Motivo: ${detalles.motivo}.`;
+  return { id: row.id, fecha: row.fecha.toISOString(), actor: row.actor, roles: row.roles, modulo, accion, entidad: row.entidad, metodo: 'REGISTRO', descripcion, detalles };
+}
+
+@Injectable()
+export class AuditoriaService {
+  constructor(private readonly prisma: PrismaService) {}
+
+  async listar(filtro: ListarAuditoriaDto) {
+    const desde = filtro.desde ? new Date(filtro.desde) : null;
+    const hasta = filtro.hasta ? new Date(filtro.hasta) : null;
+    if (desde && hasta && desde >= hasta) throw new BadRequestException('El inicio del periodo debe ser anterior al final.');
+    // Solo campos operativos permitidos. Nunca devolver contraseñas, tokens,
+    // documentos, IP, user-agent o el JSON completo de valores anteriores/nuevos.
+    const eventos = Prisma.sql`
+      WITH eventos AS (
+        SELECT 'auditoria:' || a.id::text AS id, a.created_at AS fecha, a.usuario_id,
+               a.entidad AS modulo, a.accion, coalesce(a.entidad_id, a.entidad) AS entidad,
+               coalesce(a.valores_nuevos->>'nombre', a.valores_nuevos->>'codigo', a.entidad_id) AS referencia,
+               jsonb_build_object('campos', (
+                 SELECT string_agg(k, ', ' ORDER BY k)
+                 FROM unnest(ARRAY['nombre','direccion','ciudad','estado','tipo','capacidad_kg','activo','valor','valores','tiene_flota_propia','PESO_PROXIMIDAD','PESO_URGENCIA','PESO_CONFIABILIDAD','PESO_HOLGURA','MAX_PARADAS_POR_RUTA']) AS campos(k)
+                 WHERE jsonb_typeof(a.valores_nuevos) = 'object' AND a.valores_nuevos ? k
+                   AND a.valores_nuevos->k IS DISTINCT FROM a.valores_anteriores->k
+               )) AS detalles
+          FROM auditoria a
+        UNION ALL
+        SELECT 'historial:' || h.id::text, h.created_at, h.usuario_id, h.ambito::text, 'CAMBIAR_ESTADO',
+               coalesce(h.donacion_id, h.asignacion_id, h.ruta_id, h.parada_id, h.incidencia_id, h.lote_id)::text,
+               coalesce(d.codigo, r.codigo, l.codigo_lote, h.donacion_id::text, h.ruta_id::text, h.lote_id::text),
+               jsonb_build_object('estado_anterior', h.estado_anterior, 'estado_nuevo', h.estado_nuevo, 'motivo', h.motivo)
+          FROM historial_estado h
+          LEFT JOIN donacion d ON d.id = h.donacion_id
+          LEFT JOIN ruta r ON r.id = h.ruta_id
+          LEFT JOIN lote_inventario l ON l.id = h.lote_id
+        UNION ALL
+        SELECT 'inventario:' || m.id::text, m.created_at, m.usuario_id, 'movimiento_inventario', m.tipo::text,
+               m.lote_id::text, l.codigo_lote,
+               jsonb_build_object('cantidad', m.cantidad::text, 'saldo_cantidad', m.saldo_cantidad::text, 'peso_kg', m.peso_kg::text, 'motivo', m.motivo)
+          FROM movimiento_inventario m JOIN lote_inventario l ON l.id = m.lote_id
+      ), filtrados AS (
+        SELECT * FROM eventos WHERE (${desde}::timestamptz IS NULL OR fecha >= ${desde})
+          AND (${hasta}::timestamptz IS NULL OR fecha < ${hasta})
+      )`;
+    const [rows, counts] = await this.prisma.$transaction([
+      this.prisma.$queryRaw<Movimiento[]>(Prisma.sql`${eventos}
+        SELECT e.*, coalesce(u.email, nullif(trim(concat_ws(' ', u.nombres, u.apellidos)), ''), CASE WHEN e.usuario_id IS NULL THEN 'Sistema' ELSE 'Cuenta eliminada' END) AS actor,
+               ARRAY(SELECT r.codigo FROM usuario_rol ur JOIN rol r ON r.id = ur.rol_id
+                     WHERE ur.usuario_id = e.usuario_id AND ur.activo ORDER BY r.codigo) AS roles
+          FROM filtrados e LEFT JOIN usuario u ON u.id = e.usuario_id
+         ORDER BY e.fecha DESC, e.id DESC LIMIT ${filtro.limite} OFFSET ${filtro.desplazamiento}`),
+      this.prisma.$queryRaw<{ total: number }[]>(Prisma.sql`${eventos} SELECT count(*)::int AS total FROM filtrados`),
+    ], { isolationLevel: Prisma.TransactionIsolationLevel.RepeatableRead });
+    return { datos: rows.map(presentarMovimiento), total: counts[0]?.total ?? 0, limite: filtro.limite, desplazamiento: filtro.desplazamiento };
+  }
+}
