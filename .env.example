# api conecta los servicios; demo permite recorrer el cascarón sin credenciales.
VITE_DATA_MODE=api
# URL base con el prefijo /v1. Ajustar al puerto real de la API.
VITE_API_URL=http://localhost:3002/v1
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave pública publishable (sb_publishable_...) o anon heredada.
# Nunca service_role, secret, JWT_SECRET ni DATABASE_URL.
VITE_SUPABASE_PUBLISHABLE_KEY=
